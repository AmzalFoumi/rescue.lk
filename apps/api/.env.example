# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# App
PORT=3000
CORS_ORIGIN=http://localhost:3001

# MongoDB Atlas free-tier (M0) cluster connection string.
# Get this from your Atlas dashboard: Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rescue_lk?retryWrites=true&w=majority

# UC1 warnings: attempts per alert channel before a delivery is recorded as failed.
MAX_SEND_ATTEMPTS=3

# UC1 DEMO ONLY: channels whose first send attempt fails, so the warning is sent
# on the 2nd attempt (shows automatic retry). Comma separated: SMS, PUSH, SIREN.
# Leave empty for normal behaviour.
MOCK_FAIL_FIRST_ATTEMPT_CHANNELS=
